{
  "name": "figma-import-community",
  "version": "2.1.0-preview.7",
  "description": "社区版：在插件内导入 AI / EPS / PS / PSD / PSB / PDF",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.code.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "npm run typecheck && node tests/core.mjs && node tests/preflight.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:samples": "node tests/samples.mjs",
    "test:compiled": "node tests/compiled-import.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:bundle": "node tests/bundle.mjs && node tests/bootstrap.mjs"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.138.0",
    "@napi-rs/canvas": "^1.0.8",
    "esbuild": "^0.21.5",
    "jsdom": "^29.1.1",
    "playwright": "1.62.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ag-psd": "31.0.2",
    "fflate": "0.8.2",
    "pdfjs-dist": "6.3.289"
  },
  "private": true
}
